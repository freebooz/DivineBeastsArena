@*
中文阅读说明：
- 所属应用：DBA_GameAdmin GM 管理后台。
- 文件职责：Blazor 页面组件，负责 GM 后台具体页面的交互、表单提交和接口调用展示。
- 阅读重点：先看公开类型、路由/组件入口和构造函数，再看私有辅助方法，理解数据如何从输入流向状态变更或界面输出。
- 修改提示：保持现有分层边界；新增逻辑优先复用本目录已有服务、DTO、组件和工具函数，避免把配置、IO 与业务规则混在一起。
*@

@using MudBlazor
@using DBA_GameAdmin.Services
@inject ApiClient Api
@page "/players/{PlayerId:guid}"

<MudText Typo="Typo.h4" Class="mb-4">玩家详情</MudText>

@if (_player is null)
{
    <MudAlert Severity="Severity.Warning">@(_error ?? "未找到玩家。")</MudAlert>
}
else
{
    <MudTabs>
        <MudTabPanel Text="资料">
            <MudPaper Class="pa-4 mt-3" Elevation="1">
                <MudText>玩家ID：@_player.PlayerId</MudText>
                <MudText>昵称：@_player.Nickname</MudText>
                <MudText>账号类型：@_player.AccountType</MudText>
                <MudText>账号状态：@_player.Status</MudText>
                <MudText>邮箱：@(_player.Email ?? "-")</MudText>
                <MudText>等级：@_player.Level</MudText>
                <MudText>经验：@_player.Exp</MudText>
                <MudText>最近登录：@FormatDate(_player.LastLoginAt)</MudText>
            </MudPaper>
        </MudTabPanel>
        <MudTabPanel Text="战斗统计">
            <MudPaper Class="pa-4 mt-3" Elevation="1">
                <MudText>总场次：@_player.Statistics.TotalMatches</MudText>
                <MudText>胜/负/平：@_player.Statistics.Wins / @_player.Statistics.Losses / @_player.Statistics.Draws</MudText>
                <MudText>击杀/死亡/助攻：@_player.Statistics.Kills / @_player.Statistics.Deaths / @_player.Statistics.Assists</MudText>
                <MudText>总分：@_player.Statistics.Score</MudText>
                <MudText>游戏时长：@TimeSpan.FromSeconds(_player.Statistics.PlayTimeSeconds).ToString(@"hh\:mm\:ss")</MudText>
            </MudPaper>
        </MudTabPanel>
        <MudTabPanel Text="背包">
            <MudTable Items="_player.Inventory" Hover="true" Striped="true" Class="mt-3">
                <HeaderContent>
                    <MudTh>物品ID</MudTh>
                    <MudTh>数量</MudTh>
                    <MudTh>过期时间</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ItemId</MudTd>
                    <MudTd>@context.Quantity</MudTd>
                    <MudTd>@FormatDate(context.ExpiresAt)</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Color="Color.Secondary">暂无物品。</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>
        <MudTabPanel Text="解锁">
            <MudTable Items="_player.Unlocks" Hover="true" Striped="true" Class="mt-3">
                <HeaderContent>
                    <MudTh>类型</MudTh>
                    <MudTh>内容ID</MudTh>
                    <MudTh>来源</MudTh>
                    <MudTh>解锁时间</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.UnlockType</MudTd>
                    <MudTd>@context.UnlockId</MudTd>
                    <MudTd>@context.Source</MudTd>
                    <MudTd>@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Color="Color.Secondary">暂无解锁记录。</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public Guid PlayerId { get; set; }

    private PlayerDetailDto? _player;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _player = await Api.GetPlayerAsync(PlayerId);
        if (_player is null)
        {
            _error = "无法读取玩家详情，请确认已经登录后台且 API 服务可用。";
        }
    }

    private static string FormatDate(DateTimeOffset? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-";
}
