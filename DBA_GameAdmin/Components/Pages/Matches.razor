@*
中文阅读说明：
- 所属应用：GameAdmin GM 管理后台。
- 文件职责：Blazor 页面组件，负责 GM 后台具体页面的交互、表单提交和接口调用展示。
- 阅读重点：先看公开类型、路由/组件入口和构造函数，再看私有辅助方法，理解数据如何从输入流向状态变更或界面输出。
- 修改提示：保持现有分层边界；新增逻辑优先复用本目录已有服务、DTO、组件和工具函数，避免把配置、IO 与业务规则混在一起。
*@

@using MudBlazor
@using GameAdmin.Services
@inject ApiClient Api
@page "/matches"

<MudText Typo="Typo.h4" Class="mb-4">对局记录</MudText>

<MudText Class="mb-3" Color="Color.Secondary">共 @_totalCount 条结算记录。</MudText>

<MudTable Items="_matches" Hover="true" Striped="true">
    <HeaderContent>
        <MudTh>结算ID</MudTh>
        <MudTh>会话ID</MudTh>
        <MudTh>模式</MudTh>
        <MudTh>地图</MudTh>
        <MudTh>玩家数</MudTh>
        <MudTh>时长</MudTh>
        <MudTh>创建时间</MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Id</MudTd>
        <MudTd>@context.SessionId</MudTd>
        <MudTd>@context.Mode</MudTd>
        <MudTd>@context.MapId</MudTd>
        <MudTd>@context.PlayerCount</MudTd>
        <MudTd>@TimeSpan.FromSeconds(context.DurationSeconds).ToString(@"mm\:ss")</MudTd>
        <MudTd>@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
        <MudTd>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Href="@($"/matches/{context.Id}")">详情</MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">暂无对局结算记录。</MudText>
    </NoRecordsContent>
</MudTable>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Warning" Class="mt-3">@_error</MudAlert>
}

@code {
    private List<MatchDto> _matches = new();
    private int _totalCount;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var data = await Api.GetMatchesAsync();
        if (data is null)
        {
            _error = "无法读取对局记录，请确认已经登录后台且 API 服务可用。";
            return;
        }

        _matches = data.Items.ToList();
        _totalCount = data.TotalCount;
    }
}
