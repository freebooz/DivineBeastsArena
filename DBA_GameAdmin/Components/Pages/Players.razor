@*
中文阅读说明：
- 所属应用：DBA_GameAdmin GM 管理后台。
- 文件职责：Blazor 页面组件，负责 GM 后台具体页面的交互、表单提交和接口调用展示。
- 阅读重点：先看公开类型、路由/组件入口和构造函数，再看私有辅助方法，理解数据如何从输入流向状态变更或界面输出。
- 修改提示：保持现有分层边界；新增逻辑优先复用本目录已有服务、DTO、组件和工具函数，避免把配置、IO 与业务规则混在一起。
*@

@using MudBlazor
@using DBA_GameAdmin.Services
@inject ApiClient Api
@page "/players"

<MudText Typo="Typo.h4" Class="mb-4">玩家管理</MudText>

<MudText Class="mb-3" Color="Color.Secondary">
    共 @_totalCount 名玩家，当前显示 @_players.Count 条。
</MudText>

<MudTable Items="_players" Hover="true" Striped="true">
    <HeaderContent>
        <MudTh>玩家ID</MudTh>
        <MudTh>昵称</MudTh>
        <MudTh>账号类型</MudTh>
        <MudTh>账号状态</MudTh>
        <MudTh>等级</MudTh>
        <MudTh>角色数</MudTh>
        <MudTh>选中角色</MudTh>
        <MudTh>最近登录</MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.PlayerId</MudTd>
        <MudTd>@context.Nickname</MudTd>
        <MudTd>
            <MudChip T="string" Size="Size.Small">@context.AccountType</MudChip>
        </MudTd>
        <MudTd><MudChip T="string" Color="@GetStatusColor(context.AccountStatus)" Size="Size.Small">@context.AccountStatus</MudChip></MudTd>
        <MudTd>@context.Level</MudTd>
        <MudTd>@context.CharacterCount</MudTd>
        <MudTd>@(context.SelectedCharacterName ?? "-")</MudTd>
        <MudTd>@FormatDate(context.LastLoginAt)</MudTd>
        <MudTd>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Href="@($"/players/{context.PlayerId}")">详情</MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">暂无玩家数据，或尚未登录后台。</MudText>
    </NoRecordsContent>
</MudTable>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Warning" Class="mt-3">@_error</MudAlert>
}

@code {
    private List<PlayerDto> _players = new();
    private int _totalCount;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var data = await Api.GetPlayersAsync();
        if (data is null)
        {
            _error = "无法读取玩家列表，请确认已经登录后台且 API 服务可用。";
            return;
        }

        _players = data.Items.ToList();
        _totalCount = data.TotalCount;
    }

    private static Color GetStatusColor(string status)
    {
        return string.Equals(status, "ACTIVE", StringComparison.OrdinalIgnoreCase) ? Color.Success : Color.Error;
    }

    private static string FormatDate(DateTimeOffset? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-";
}
