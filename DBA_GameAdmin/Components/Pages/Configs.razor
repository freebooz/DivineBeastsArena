@*
中文阅读说明：
- 所属应用：GameAdmin GM 管理后台。
- 文件职责：Blazor 页面组件，负责 GM 后台具体页面的交互、表单提交和接口调用展示。
- 阅读重点：先看公开类型、路由/组件入口和构造函数，再看私有辅助方法，理解数据如何从输入流向状态变更或界面输出。
- 修改提示：保持现有分层边界；新增逻辑优先复用本目录已有服务、DTO、组件和工具函数，避免把配置、IO 与业务规则混在一起。
*@

@using MudBlazor
@using GameAdmin.Services
@inject ApiClient Api
@page "/configs"

<MudText Typo="Typo.h4" Class="mb-4">配置管理</MudText>

<MudTabs Rounded="true" Elevation="1" Class="mb-4">
    <MudTabPanel Text="游戏配置">
<MudTable Items="_configs" Hover="true" Striped="true">
    <HeaderContent>
        <MudTh>配置键</MudTh>
        <MudTh>版本</MudTh>
        <MudTh>状态</MudTh>
        <MudTh>渠道</MudTh>
        <MudTh>地区</MudTh>
        <MudTh>发布时间</MudTh>
        <MudTh>内容摘要</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.ConfigKey</MudTd>
        <MudTd>@context.Version</MudTd>
        <MudTd><MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip></MudTd>
        <MudTd>@context.Channel</MudTd>
        <MudTd>@context.Region</MudTd>
        <MudTd>@FormatDate(context.PublishedAt)</MudTd>
        <MudTd>@TrimJson(context.ContentJson)</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">暂无配置数据。</MudText>
    </NoRecordsContent>
</MudTable>
    </MudTabPanel>
    <MudTabPanel Text="客户端版本">
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">发布 Launcher Manifest 元数据</MudText>
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudTextField Label="版本" @bind-Value="_versionForm.Version" Required="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Label="渠道" @bind-Value="_versionForm.Channel" Required="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Label="平台" @bind-Value="_versionForm.Platform" Required="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudNumericField T="long" Label="文件大小" @bind-Value="_versionForm.SizeBytes" Required="true" Min="1" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="下载地址" @bind-Value="_versionForm.DownloadUrl" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="SHA256" @bind-Value="_versionForm.Checksum" Required="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Label="最低系统版本" @bind-Value="_versionForm.MinOsVersion" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudCheckBox T="bool" Label="强制更新" @bind-Value="_versionForm.IsMandatory" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudCheckBox T="bool" Label="设为活跃版本" @bind-Value="_versionForm.IsActive" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="发布说明" Lines="3" @bind-Value="_versionForm.ReleaseNotes" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="操作原因" @bind-Value="_versionForm.Reason" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_savingVersion" OnClick="SaveClientVersionAsync">
                        @(_savingVersion ? "保存中..." : "保存版本元数据")
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudTable Items="_clientVersions" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>版本</MudTh>
                <MudTh>渠道</MudTh>
                <MudTh>平台</MudTh>
                <MudTh>状态</MudTh>
                <MudTh>强更</MudTh>
                <MudTh>大小</MudTh>
                <MudTh>创建时间</MudTh>
                <MudTh>下载地址</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Version</MudTd>
                <MudTd>@context.Channel</MudTd>
                <MudTd>@context.Platform</MudTd>
                <MudTd><MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Default)" Size="Size.Small">@(context.IsActive ? "ACTIVE" : "INACTIVE")</MudChip></MudTd>
                <MudTd>@(context.IsMandatory ? "是" : "否")</MudTd>
                <MudTd>@FormatBytes(context.SizeBytes)</MudTd>
                <MudTd>@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                <MudTd>@TrimText(context.DownloadUrl, 48)</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Color="Color.Secondary">暂无客户端版本数据。</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>
</MudTabs>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Warning" Class="mt-3">@_error</MudAlert>
}

@code {
    private List<ConfigDto> _configs = new();
    private List<AdminClientVersionDto> _clientVersions = new();
    private ClientVersionForm _versionForm = new();
    private string? _error;
    private bool _savingVersion;

    protected override async Task OnInitializedAsync()
    {
        var data = await Api.GetConfigsAsync();
        if (data is null)
        {
            _error = "无法读取配置列表，请确认已经登录后台且 API 服务可用。";
            return;
        }

        _configs = data;
        await LoadClientVersionsAsync();
    }

    private async Task LoadClientVersionsAsync()
    {
        var versions = await Api.GetClientVersionsAsync();
        if (versions is not null)
        {
            _clientVersions = versions.Items.ToList();
        }
    }

    private async Task SaveClientVersionAsync()
    {
        _error = null;
        _savingVersion = true;
        try
        {
            var saved = await Api.UpsertClientVersionAsync(new UpsertClientVersionDto(
                _versionForm.Version,
                _versionForm.Channel,
                _versionForm.Platform,
                _versionForm.DownloadUrl,
                _versionForm.Checksum,
                _versionForm.SizeBytes,
                _versionForm.IsMandatory,
                _versionForm.IsActive,
                string.IsNullOrWhiteSpace(_versionForm.MinOsVersion) ? null : _versionForm.MinOsVersion,
                string.IsNullOrWhiteSpace(_versionForm.ReleaseNotes) ? null : _versionForm.ReleaseNotes,
                _versionForm.Reason));

            if (saved is null)
            {
                _error = "保存客户端版本失败，请检查必填项、下载地址、SHA256、文件大小和操作原因。";
                return;
            }

            _versionForm = new ClientVersionForm();
            await LoadClientVersionsAsync();
        }
        finally
        {
            _savingVersion = false;
        }
    }

    private static Color GetStatusColor(string status)
    {
        return string.Equals(status, "PUBLISHED", StringComparison.OrdinalIgnoreCase) ? Color.Success : Color.Warning;
    }

    private static string FormatDate(DateTimeOffset? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-";

    private static string TrimJson(string value) => value.Length <= 80 ? value : value[..80] + "...";

    private static string TrimText(string value, int maxLength) => value.Length <= maxLength ? value : value[..maxLength] + "...";

    private static string FormatBytes(long value)
    {
        if (value < 1024) return $"{value} B";
        if (value < 1024 * 1024) return $"{value / 1024d:0.0} KB";
        if (value < 1024L * 1024 * 1024) return $"{value / 1024d / 1024d:0.0} MB";
        return $"{value / 1024d / 1024d / 1024d:0.00} GB";
    }

    private sealed class ClientVersionForm
    {
        public string Version { get; set; } = "0.1.1";
        public string Channel { get; set; } = "stable";
        public string Platform { get; set; } = "Windows";
        public string DownloadUrl { get; set; } = "";
        public string Checksum { get; set; } = "";
        public long SizeBytes { get; set; }
        public bool IsMandatory { get; set; }
        public bool IsActive { get; set; } = true;
        public string? MinOsVersion { get; set; } = "Windows 10";
        public string? ReleaseNotes { get; set; }
        public string Reason { get; set; } = "";
    }
}
