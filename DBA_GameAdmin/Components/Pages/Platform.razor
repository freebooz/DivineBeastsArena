@*
中文阅读说明：
- 所属应用：GameAdmin GM 管理后台。
- 文件职责：Blazor 页面组件，负责 GM 后台具体页面的交互、表单提交和接口调用展示。
- 阅读重点：先看公开类型、路由/组件入口和构造函数，再看私有辅助方法，理解数据如何从输入流向状态变更或界面输出。
- 修改提示：保持现有分层边界；新增逻辑优先复用本目录已有服务、DTO、组件和工具函数，避免把配置、IO 与业务规则混在一起。
*@

@using MudBlazor
@using GameAdmin.Services
@inject ApiClient Api
@page "/platform"

<MudText Typo="Typo.h4" Class="mb-2">平台应用结构</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
    查看 GamePlatform 各应用的职责、运行方式、集成点和后续完善方向。
</MudText>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_catalog is null)
{
    <MudAlert Severity="Severity.Warning">
        无法连接 Game.Api 的 /api/platform/applications，请确认后端服务已启动且 ApiBaseUrl 配置正确。
    </MudAlert>
}
else
{
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
        生成时间：@_catalog.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
    </MudText>

    <MudGrid>
        @foreach (var app in _catalog.Applications)
        {
            <MudItem xs="12" lg="6">
                <MudCard Class="h-100">
                    <MudCardContent>
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudText Typo="Typo.h6">@app.Name</MudText>
                            <MudChip T="string" Color="@GetStatusColor(app.Status)" Size="Size.Small">@app.Status</MudChip>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@app.Category / @app.Runtime</MudText>
                        <MudText Typo="Typo.body2" Class="mt-3">@app.Goal</MudText>

                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2">目录</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">@app.Directory</MudText>

                        <MudText Typo="Typo.subtitle2">运行命令</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">@app.RunCommand</MudText>

                        <MudText Typo="Typo.subtitle2">健康检查</MudText>
                        <MudText Typo="Typo.body2" Class="mb-3">@app.HealthCheck</MudText>

                        <MudExpansionPanels Dense="true" Elevation="0">
                            <MudExpansionPanel Text="核心职责">
                                <ul class="platform-list">
                                    @foreach (var item in app.Responsibilities)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </MudExpansionPanel>
                            <MudExpansionPanel Text="集成点">
                                <ul class="platform-list">
                                    @foreach (var item in app.IntegrationPoints)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </MudExpansionPanel>
                            <MudExpansionPanel Text="后续完善">
                                <ul class="platform-list">
                                    @foreach (var item in app.NextSteps)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private bool _loading = true;
    private PlatformApplicationsDto? _catalog;

    protected override async Task OnInitializedAsync()
    {
        _catalog = await Api.GetPlatformApplicationsAsync();
        _loading = false;
    }

    private static Color GetStatusColor(string status) => status switch
    {
        "Implemented" => Color.Success,
        "Partially implemented" => Color.Warning,
        "Skeleton" => Color.Error,
        _ => Color.Default
    };
}

<style>
    .platform-list {
        margin: 0;
        padding-left: 1.25rem;
    }

    .platform-list li {
        margin: 0.25rem 0;
    }
</style>
