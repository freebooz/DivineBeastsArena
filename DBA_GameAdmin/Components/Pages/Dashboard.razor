@*
中文阅读说明：
- 所属应用：DBA_GameAdmin GM 管理后台。
- 文件职责：Blazor 页面组件，负责 GM 后台具体页面的交互、表单提交和接口调用展示。
- 阅读重点：先看公开类型、路由/组件入口和构造函数，再看私有辅助方法，理解数据如何从输入流向状态变更或界面输出。
- 修改提示：保持现有分层边界；新增逻辑优先复用本目录已有服务、DTO、组件和工具函数，避免把配置、IO 与业务规则混在一起。
*@

@using MudBlazor
@using DBA_GameAdmin.Services
@inject ApiClient Api
@page "/dashboard"

<MudText Typo="Typo.h4" Class="mb-2">运营仪表盘</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
    汇总账号、角色、游戏服务端、客服、举报、公告、活动和版本发布状态。
</MudText>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_status is null)
{
    <MudAlert Severity="Severity.Warning">
        无法读取运营状态，请确认 Game.Api 已启动且数据库连接正常。
    </MudAlert>
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h5">@_status.TotalAccounts</MudText>
                <MudText Color="Color.Secondary">账号总数</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h5">@_status.TotalCharacters</MudText>
                <MudText Color="Color.Secondary">角色总数</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h5">@_status.ActiveGameServers</MudText>
                <MudText Color="Color.Secondary">活跃服务端</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h5">@_status.LatestClientVersion</MudText>
                <MudText Color="Color.Secondary">最新客户端版本</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6">@_status.OpenSupportTickets</MudText>
                <MudText Color="Color.Secondary">待处理工单</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6">@_status.OpenReports</MudText>
                <MudText Color="Color.Secondary">待处理举报</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6">@_status.ActiveAnnouncements</MudText>
                <MudText Color="Color.Secondary">生效公告</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6">@_status.ActiveEvents</MudText>
                <MudText Color="Color.Secondary">生效活动</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">健康检查</MudText>
        <MudTable Items="_status.HealthItems" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>项目</MudTh>
                <MudTh>状态</MudTh>
                <MudTh>说明</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@GetHealthColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
                </MudTd>
                <MudTd>@context.Detail</MudTd>
            </RowTemplate>
        </MudTable>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3">
            更新时间：@_status.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
        </MudText>
    </MudPaper>
}

@code {
    private bool _loading = true;
    private OperationsStatusDto? _status;

    protected override async Task OnInitializedAsync()
    {
        _status = await Api.GetOperationsStatusAsync();
        _loading = false;
    }

    private static Color GetHealthColor(string status) => status switch
    {
        "OK" => Color.Success,
        "WARN" => Color.Warning,
        "ERROR" => Color.Error,
        _ => Color.Default
    };
}
