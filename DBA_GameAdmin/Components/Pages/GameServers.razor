@*
中文阅读说明：
- 所属应用：GameAdmin GM 管理后台。
- 文件职责：Blazor 页面组件，负责 GM 后台具体页面的交互、表单提交和接口调用展示。
- 阅读重点：先看公开类型、路由/组件入口和构造函数，再看私有辅助方法，理解数据如何从输入流向状态变更或界面输出。
- 修改提示：保持现有分层边界；新增逻辑优先复用本目录已有服务、DTO、组件和工具函数，避免把配置、IO 与业务规则混在一起。
*@

@using MudBlazor
@using GameAdmin.Services
@inject ApiClient Api
@inject IJSRuntime JS
@page "/servers"
@page "/gameservers"

<MudText Typo="Typo.h4" Class="mb-4">游戏服务器</MudText>

<MudText Class="mb-3" Color="Color.Secondary">共 @_totalCount 个服务器实例。</MudText>

<MudTable Items="_servers" Hover="true" Striped="true">
    <HeaderContent>
        <MudTh>服务器ID</MudTh>
        <MudTh>地址</MudTh>
        <MudTh>模式</MudTh>
        <MudTh>地图</MudTh>
        <MudTh>状态</MudTh>
        <MudTh>启动时间</MudTh>
        <MudTh>最后心跳</MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Id</MudTd>
        <MudTd>@context.Ip:@context.Port</MudTd>
        <MudTd>@(context.Mode ?? "-")</MudTd>
        <MudTd>@(context.MapId ?? "-")</MudTd>
        <MudTd>
            <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
        </MudTd>
        <MudTd>@context.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
        <MudTd>@FormatDate(context.LastHeartbeatAt)</MudTd>
        <MudTd>
            <MudButton Color="Color.Error"
                       Variant="Variant.Outlined"
                       Size="Size.Small"
                       Disabled="_busy || IsTerminal(context.Status)"
                       OnClick="@(() => PrepareKill(context))">
                Kill
            </MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">暂无服务器实例。</MudText>
    </NoRecordsContent>
</MudTable>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Warning" Class="mt-3">@_error</MudAlert>
}

@if (!string.IsNullOrEmpty(_success))
{
    <MudAlert Severity="Severity.Success" Class="mt-3">@_success</MudAlert>
}

@if (_selectedServer is not null)
{
    <MudPaper Class="pa-4 mt-4" Elevation="1">
        <MudText Typo="Typo.h6">Kill Server 确认</MudText>
        <MudText Class="mt-2">服务器：@_selectedServer.Id (@_selectedServer.Ip:@_selectedServer.Port)</MudText>
        <MudTextField @bind-Value="_killReason"
                      Label="原因 reason"
                      Variant="Variant.Outlined"
                      Class="mt-3"
                      Immediate="true"
                      Required="true" />
        <MudButton Color="Color.Error" Variant="Variant.Filled" Class="mt-3 mr-2" Disabled="_busy" OnClick="KillSelectedAsync">确认 Kill</MudButton>
        <MudButton Color="Color.Default" Variant="Variant.Text" Class="mt-3" Disabled="_busy" OnClick="CancelKill">取消</MudButton>
    </MudPaper>
}

@code {
    private List<GameServerDto> _servers = new();
    private int _totalCount;
    private string? _error;
    private string? _success;
    private bool _busy;
    private GameServerDto? _selectedServer;
    private string _killReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var data = await Api.GetGameServersAsync();
        if (data is null)
        {
            _error = "无法读取服务器列表，请确认已经登录后台且 API 服务可用。";
            return;
        }

        _servers = data.Items.ToList();
        _totalCount = data.TotalCount;
    }

    private void PrepareKill(GameServerDto server)
    {
        _error = null;
        _success = null;
        _selectedServer = server;
        _killReason = string.Empty;
    }

    private void CancelKill()
    {
        _selectedServer = null;
        _killReason = string.Empty;
    }

    private async Task KillSelectedAsync()
    {
        if (_selectedServer is null) return;
        if (string.IsNullOrWhiteSpace(_killReason))
        {
            _error = "Kill Server 必须填写 reason。";
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"确认 Kill 游戏服务器 {_selectedServer.Id}？原因：{_killReason}");
        if (!confirmed) return;

        _busy = true;
        _error = null;
        _success = null;
        try
        {
            var ok = await Api.KillGameServerAsync(_selectedServer.Id, _killReason.Trim());
            if (!ok)
            {
                _error = "Kill Server 失败，请确认权限、服务器状态和 API 服务。";
                return;
            }

            _success = "Kill Server 操作已提交。";
            _selectedServer = null;
            _killReason = string.Empty;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static Color GetStatusColor(string status)
    {
        return status is "READY" or "IDLE" or "RUNNING" ? Color.Success : Color.Warning;
    }

    private static bool IsTerminal(string status)
    {
        return status is "STOPPED" or "CRASHED" or "TIMEOUT";
    }

    private static string FormatDate(DateTimeOffset? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-";
}
