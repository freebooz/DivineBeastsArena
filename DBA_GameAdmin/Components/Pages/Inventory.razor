@*
中文阅读说明：
- 所属应用：GameAdmin GM 管理后台。
- 文件职责：Blazor 页面组件，负责 GM 后台具体页面的交互、表单提交和接口调用展示。
- 阅读重点：先看公开类型、路由/组件入口和构造函数，再看私有辅助方法，理解数据如何从输入流向状态变更或界面输出。
- 修改提示：保持现有分层边界；新增逻辑优先复用本目录已有服务、DTO、组件和工具函数，避免把配置、IO 与业务规则混在一起。
*@

@using MudBlazor
@using GameAdmin.Services
@inject ApiClient Api
@page "/inventory"

<MudText Typo="Typo.h4" Class="mb-4">背包流水</MudText>

<MudTable Items="_items" Hover="true" Striped="true">
    <HeaderContent>
        <MudTh>玩家ID</MudTh>
        <MudTh>物品ID</MudTh>
        <MudTh>数量变化</MudTh>
        <MudTh>原因</MudTh>
        <MudTh>时间</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.PlayerId</MudTd>
        <MudTd>@context.ItemId</MudTd>
        <MudTd>
            <MudChip T="string" Color="@(context.QuantityDelta >= 0 ? Color.Success : Color.Error)" Size="Size.Small">
                @context.QuantityDelta
            </MudChip>
        </MudTd>
        <MudTd>@context.Reason</MudTd>
        <MudTd>@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">暂无背包流水。</MudText>
    </NoRecordsContent>
</MudTable>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Warning" Class="mt-3">@_error</MudAlert>
}

@code {
    private List<AdminInventoryLogDto> _items = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var data = await Api.GetInventoryLogsAsync();
        if (data is null)
        {
            _error = "无法读取背包流水，请确认已经登录后台且 API 服务可用。";
            return;
        }

        _items = data;
    }
}
