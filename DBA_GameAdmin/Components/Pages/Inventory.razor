@*
中文阅读说明：
- 所属应用：GameAdmin GM 管理后台。
- 文件职责：Blazor 页面组件，负责 GM 后台具体页面的交互、表单提交和接口调用展示。
- 阅读重点：先看公开类型、路由/组件入口和构造函数，再看私有辅助方法，理解数据如何从输入流向状态变更或界面输出。
- 修改提示：保持现有分层边界；新增逻辑优先复用本目录已有服务、DTO、组件和工具函数，避免把配置、IO 与业务规则混在一起。
*@

@using MudBlazor
@using GameAdmin.Services
@inject ApiClient Api
@inject IJSRuntime JS
@page "/inventory"

<MudText Typo="Typo.h4" Class="mb-4">背包流水</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-3">GM 背包操作</MudText>
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_playerIdText" Label="玩家ID" Variant="Variant.Outlined" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField @bind-Value="_itemId" Label="物品ID" Variant="Variant.Outlined" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="2">
            <MudNumericField @bind-Value="_quantity" Label="数量" Variant="Variant.Outlined" Min="1" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField @bind-Value="_reason" Label="原因 reason" Variant="Variant.Outlined" Immediate="true" Required="true" />
        </MudItem>
    </MudGrid>
    <MudStack Row="true" Spacing="2" Class="mt-3">
        <MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="_busy" OnClick="GrantAsync">发放物品</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="_busy" OnClick="DeductAsync">扣除物品</MudButton>
    </MudStack>
</MudPaper>

<MudTable Items="_items" Hover="true" Striped="true">
    <HeaderContent>
        <MudTh>玩家ID</MudTh>
        <MudTh>物品ID</MudTh>
        <MudTh>数量变化</MudTh>
        <MudTh>原因</MudTh>
        <MudTh>时间</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.PlayerId</MudTd>
        <MudTd>@context.ItemId</MudTd>
        <MudTd>
            <MudChip T="string" Color="@(context.QuantityDelta >= 0 ? Color.Success : Color.Error)" Size="Size.Small">
                @context.QuantityDelta
            </MudChip>
        </MudTd>
        <MudTd>@context.Reason</MudTd>
        <MudTd>@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">暂无背包流水。</MudText>
    </NoRecordsContent>
</MudTable>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Warning" Class="mt-3">@_error</MudAlert>
}
@if (!string.IsNullOrEmpty(_message))
{
    <MudAlert Severity="Severity.Success" Class="mt-3">@_message</MudAlert>
}

@code {
    private List<AdminInventoryLogDto> _items = new();
    private string? _error;
    private string? _message;
    private string _playerIdText = string.Empty;
    private string _itemId = string.Empty;
    private long _quantity = 1;
    private string _reason = string.Empty;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task GrantAsync()
    {
        await MutateAsync("发放", Api.GrantInventoryItemAsync);
    }

    private async Task DeductAsync()
    {
        await MutateAsync("扣除", Api.DeductInventoryItemAsync);
    }

    private async Task MutateAsync(string action, Func<Guid, string, long, string, Task<bool>> operation)
    {
        _error = null;
        _message = null;

        if (!Guid.TryParse(_playerIdText, out var playerId))
        {
            _error = "玩家ID格式不正确。";
            return;
        }

        if (string.IsNullOrWhiteSpace(_itemId) || _quantity <= 0 || string.IsNullOrWhiteSpace(_reason))
        {
            _error = "物品ID、正数数量和 reason 都必须填写。";
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"确认{action}玩家 {playerId} 的物品 {_itemId}，数量 {_quantity}？原因：{_reason}");
        if (!confirmed)
        {
            return;
        }

        _busy = true;
        try
        {
            var ok = await operation(playerId, _itemId.Trim(), _quantity, _reason.Trim());
            if (!ok)
            {
                _error = $"{action}失败，请检查权限、玩家ID、物品数量和后端日志。";
                return;
            }

            _message = $"{action}成功。";
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        var data = await Api.GetInventoryLogsAsync();
        if (data is null)
        {
            _error = "无法读取背包流水，请确认已经登录后台且 API 服务可用。";
            return;
        }

        _items = data;
    }
}
