# 基础镜像配置
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-github-org-or-user
IMAGE_TAG=latest

# ASP.NET Core / API 配置
ASPNETCORE_ENVIRONMENT=Production
SWAGGER_ENABLED=false
SEED_DATA_ENABLED=false
LOG_LEVEL=Information
BACKEND_INTERNAL_URL=http://game-api:8080

# 对外入口配置
PUBLIC_DOMAIN=game.example.com
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL 只在 Docker 内网暴露，请务必在生产环境替换强密码
POSTGRES_DB=game_platform
POSTGRES_USER=game_app
POSTGRES_PASSWORD=change-this-postgres-password

# Redis 只在 Docker 内网暴露，请务必在生产环境替换强密码
REDIS_PASSWORD=change-this-redis-password

# JWT / 内部服务密钥，必须使用足够长的随机值
JWT_ISSUER=DivineBeastsArena
JWT_AUDIENCE=DivineBeastsArenaClient
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_KEY=replace-with-random-internal-api-key

# UE Dedicated Server 管理配置
GAME_SERVER_MODE=LocalProcess
GAME_SERVER_PUBLIC_IP=127.0.0.1
GAME_SERVER_PORT_START=7777
GAME_SERVER_PORT_END=7877
UE_SERVER_IMAGE=
UE_SERVER_EXECUTABLE_PATH=/opt/game-server/GameServer.sh

# Grafana / 监控配置
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
GRAFANA_ROOT_URL=http://localhost/grafana/
PROMETHEUS_RETENTION=15d
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
LOKI_BIND=127.0.0.1
LOKI_PORT=3100
NODE_EXPORTER_BIND=127.0.0.1
NODE_EXPORTER_PORT=9100

# 备份配置
BACKUP_DIR=../backups
BACKUP_KEEP_DAYS=14

# 部署脚本使用，CI/CD 中由 GitHub Secrets 注入
COMPOSE_PROJECT_NAME=divine-beasts-arena
