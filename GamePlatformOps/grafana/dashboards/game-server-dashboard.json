{
  "dashboard": {
    "title": "Game Server Dashboard",
    "tags": ["game", "server"],
    "timezone": "browser",
    "panels": [
      {
        "title": "Request Rate",
        "type": "graph",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(game_server_requests_total[5m])",
            "legendFormat": "{{method}} {{path}}",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Error Rate",
        "type": "graph",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(game_server_requests_total{status=~\"5..\"}[5m])",
            "legendFormat": "{{path}}",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Latency (p95)",
        "type": "graph",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, game_server_request_duration_seconds_bucket[5m])",
            "legendFormat": "{{path}}",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Active Connections",
        "type": "graph",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "game_server_connections_active",
            "legendFormat": "Active",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Player Count",
        "type": "graph",
        "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "game_server_players_online",
            "legendFormat": "Players Online",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Active Sessions",
        "type": "graph",
        "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "game_server_active_sessions",
            "legendFormat": "Sessions",
            "refId": "A"
          }
        ]
      },
      {
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(game_server_cpu_seconds_total[5m])",
            "legendFormat": "CPU",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "game_server_memory_bytes",
            "legendFormat": "Memory",
            "refId": "A"
          }
        ]
      }
    ],
    "refresh": "10s",
    "schemaVersion": 30
  }
}