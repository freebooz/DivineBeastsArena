{
  "dashboard": {
    "title": "PostgreSQL Dashboard",
    "tags": ["database", "postgres"],
    "timezone": "browser",
    "panels": [
      {
        "title": "Request Rate",
        "type": "graph",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(pg_stat_statements_total[5m])",
            "legendFormat": "{{query}}",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Error Rate",
        "type": "graph",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(pg_stat_database_conflict_total[5m])",
            "legendFormat": "Conflicts",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Query Duration (p95)",
        "type": "graph",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, pg_stat_statements_duration_seconds_bucket[5m])",
            "legendFormat": "{{query}}",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Active Connections",
        "type": "graph",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "pg_stat_database_numbackends",
            "legendFormat": "Active",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Cache Hit Ratio",
        "type": "graph",
        "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "pg_stat_database_blks_hit / (pg_stat_database_blks_hit + pg_stat_database_blks_read)",
            "legendFormat": "Hit Ratio",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Transactions/sec",
        "type": "graph",
        "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(pg_stat_database_xact_commit[5m]) + rate(pg_stat_database_xact_rollback[5m])",
            "legendFormat": "Transactions",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Deadlocks",
        "type": "graph",
        "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(pg_stat_database_deadlocks[5m])",
            "legendFormat": "Deadlocks",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Temp Files",
        "type": "graph",
        "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(pg_stat_database_temp_bytes[5m])",
            "legendFormat": "Temp Bytes",
            "refId": "A"
          }
        ]
      }
    ],
    "refresh": "10s",
    "schemaVersion": 30
  }
}