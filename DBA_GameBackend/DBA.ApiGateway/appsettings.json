{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowMinutes": 1
  },
  "ReverseProxy": {
    "Routes": {
      "game-api": {
        "ClusterId": "game-api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "game-hubs": {
        "ClusterId": "game-api",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "game-api": {
        "Destinations": {
          "game-api-primary": {
            "Address": "http://localhost:5000/"
          }
        }
      }
    }
  }
}
