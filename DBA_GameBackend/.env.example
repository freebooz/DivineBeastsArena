# DivineBeastsArena backend production compose example.
# Copy this file to .env and replace every change-me value before deployment.

COMPOSE_PROJECT_NAME=divine-beasts-arena
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-github-org-or-user
IMAGE_TAG=latest

ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
API_HTTP_BIND=127.0.0.1

POSTGRES_DB=game_platform
POSTGRES_USER=game_app
POSTGRES_PASSWORD=change-me-postgres-password

REDIS_PASSWORD=change-me-redis-password

JWT_ISSUER=DivineBeastsArena
JWT_AUDIENCE=DivineBeastsArenaClient
JWT_SECRET=change-me-at-least-32-random-characters
INTERNAL_API_KEY=change-me-random-internal-api-key

# Production secret-file injection is supported for any configuration key.
# Examples:
# Jwt__Secret_FILE=/run/secrets/jwt_secret
# InternalApi__Key_FILE=/run/secrets/internal_api_key
# Database__ConnectionString_FILE=/run/secrets/database_connection_string
# Redis__ConnectionString_FILE=/run/secrets/redis_connection_string

SEED_DATA_ENABLED=false
SWAGGER_ENABLED=false
DATABASE_RUN_MIGRATIONS_AND_EXIT=false

GAME_SERVER_MODE=LocalProcess
GAME_SERVER_PUBLIC_IP=127.0.0.1
GAME_SERVER_PORT_START=7777
GAME_SERVER_PORT_END=7877
UE_SERVER_EXECUTABLE_PATH=/opt/game-server/GameServer.sh
BACKEND_INTERNAL_URL=http://game-api:8080
GAME_SERVER_ALLOW_MOCK_ALLOCATION=false

PUBLIC_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

PROMETHEUS_HTTP_BIND=127.0.0.1
GRAFANA_HTTP_BIND=127.0.0.1
LOKI_HTTP_BIND=127.0.0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
