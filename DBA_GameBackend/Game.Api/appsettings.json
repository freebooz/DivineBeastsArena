    "Secret": "",
    "Issuer": "GameApi",
    "Audience": "GameClients",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30
  },
  "Database": {
    "ConnectionString": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "SeedData": {
    "Enabled": false
  },
