    "TokenByteLength": 32,
    "ConnectionTokenLifetimeMinutes": 10,
    "ReconnectTokenLifetimeMinutes": 60,
    "ProvisionalTokenLifetimeMinutes": 120,
    "MatchMapId": "LobbyMap",
    "MatchMaxPlayers": 2
  },
  "VillageSession": {
    "Mode": "village",
    "MapId": "LobbyMap",
    "Region": "local",
    "BuildVersion": "",
    "MaxPlayers": 32
  },
  "Swagger": {
    "Enabled": false
  },
  "TelemetryUpload": {
    "StoragePath": "telemetry-events",
    "MaxEventsPerBatch": 500
  },
  "CrashUpload": {
    "StoragePath": "crash-uploads",
    "MaxPayloadBytes": 16777216,
    "PublicBaseUrl": ""
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 20,
      "WindowMinutes": 1
    },
    "AdminAuth": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    },
    "Admin": {
      "PermitLimit": 120,
      "WindowMinutes": 1
    }
  }
