    "AllowedElementTypes": [ "Fire", "Water", "Wood", "Gold", "Earth" ],
    "AllowedFiveCampTypes": [ "East", "West", "South", "North", "Center" ],
    "ReservedNames": [ "GM", "ADMIN", "系统" ],
