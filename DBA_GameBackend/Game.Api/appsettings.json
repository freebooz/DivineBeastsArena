{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "",
    "Issuer": "GameApi",
    "Audience": "GameClients",
    "AccessTokenExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 30
  },
  "Database": {
    "ConnectionString": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "SeedData": {
    "Enabled": false
  },
  "Swagger": {
    "Enabled": false
  },
  "TelemetryUpload": {
    "StoragePath": "telemetry-events",
    "MaxEventsPerBatch": 500
  },
  "CrashUpload": {
    "StoragePath": "crash-uploads",
    "MaxPayloadBytes": 16777216,
    "PublicBaseUrl": ""
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 20,
      "WindowMinutes": 1
    },
    "AdminAuth": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    },
    "Admin": {
      "PermitLimit": 120,
      "WindowMinutes": 1
    }
  }
}
