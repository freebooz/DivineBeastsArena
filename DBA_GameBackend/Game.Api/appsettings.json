      "Rat": { "AllowedOptionIds": [] }, "Ox": { "AllowedOptionIds": [] }, "Tiger": { "AllowedOptionIds": [] }, "Rabbit": { "AllowedOptionIds": [] },
      "Dragon": { "AllowedOptionIds": [] }, "Snake": { "AllowedOptionIds": [] }, "Horse": { "AllowedOptionIds": [] }, "Goat": { "AllowedOptionIds": [] },
      "Monkey": { "AllowedOptionIds": [] }, "Rooster": { "AllowedOptionIds": [] }, "Dog": { "AllowedOptionIds": [] }, "Pig": { "AllowedOptionIds": [] }
    },
    "CoreAttributes": {
      "MaxHealth": 1800,
      "AttackPower": 100,
      "Defense": 40,
      "MoveSpeed": 380,
      "MaxEnergy": 100,
      "EnergyRegen": 10,
      "CriticalRate": 0.05,
      "CriticalMultiplier": 2.0
    },
    "Messages": {
      "InvalidPlayer": "玩家身份无效。",
