# Game.Worker Dockerfile (单独构建Worker)
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY GameBackend.slnx ./
COPY Game.Worker/Game.Worker.csproj Game.Worker/
COPY Game.Infrastructure/Game.Infrastructure.csproj Game.Infrastructure/
COPY Game.Shared/Game.Shared.csproj Game.Shared/

RUN dotnet restore Game.Worker/Game.Worker.csproj

COPY . .
RUN dotnet build Game.Worker/Game.Worker.csproj -c Release --no-restore

FROM build AS publish
RUN dotnet publish Game.Worker/Game.Worker.csproj -c Release -o /app/publish --no-build

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

ENTRYPOINT ["dotnet", "Game.Worker.dll"]