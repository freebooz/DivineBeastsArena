@*
中文阅读说明：
- 所属应用：GameAdmin GM 管理后台。
- 文件职责：Blazor 页面组件，负责 GM 后台具体页面的交互、表单提交和接口调用展示。
- 阅读重点：先看公开类型、路由/组件入口和构造函数，再看私有辅助方法，理解数据如何从输入流向状态变更或界面输出。
- 修改提示：保持现有分层边界；新增逻辑优先复用本目录已有服务、DTO、组件和工具函数，避免把配置、IO 与业务规则混在一起。
*@

@using MudBlazor
@using GameAdmin.Services
@inject ApiClient Api
@page "/audit"

<MudText Typo="Typo.h4" Class="mb-4">审计日志</MudText>

<MudTable Items="_logs" Hover="true" Striped="true">
    <HeaderContent>
        <MudTh>管理员</MudTh>
        <MudTh>操作</MudTh>
        <MudTh>目标类型</MudTh>
        <MudTh>目标ID</MudTh>
        <MudTh>原因</MudTh>
        <MudTh>IP</MudTh>
        <MudTh>时间</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@(context.AdminUsername ?? "-")</MudTd>
        <MudTd>@context.Action</MudTd>
        <MudTd>@context.TargetType</MudTd>
        <MudTd>@context.TargetId</MudTd>
        <MudTd>@(context.Reason ?? "-")</MudTd>
        <MudTd>@(context.IpAddress ?? "-")</MudTd>
        <MudTd>@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">暂无审计日志。</MudText>
    </NoRecordsContent>
</MudTable>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Warning" Class="mt-3">@_error</MudAlert>
}

@code {
    private List<AdminAuditLogDto> _logs = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var data = await Api.GetAuditLogsAsync();
        if (data is null)
        {
            _error = "无法读取审计日志，请确认已经登录后台且 API 服务可用。";
            return;
        }

        _logs = data.Items.ToList();
    }
}
